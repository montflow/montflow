{
  "name": "@montflow/zi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: the montflow workspace — a server-first web UI (router daemon + thin pi backend + SPA render target) with agentic skill/profile authoring runs, agent profiles, and a shared event bus. All state lives under .agents/@montflow/",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:check": "oxlint --deny-warnings .",
    "fmt": "echo 'No formatter configured'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.102",
    "effect": "^4.0.0-beta.102",
    "ws": "^8.21.3"
  }
}
