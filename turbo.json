{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "ts:check": {
      "cache": true,
      "dependsOn": []
    },
    "typecheck": {
      "cache": true,
      "dependsOn": []
    },
    "format:check": {
      "cache": true,
      "dependsOn": []
    },
    "format:fix": {
      "cache": false,
      "dependsOn": []
    },
    "lint:check": {
      "cache": true,
      "dependsOn": []
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": []
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ]
    }
  }
}