!.agents/@montflow/reviews/montflow-spec-standard/
!.agents/@montflow/reviews/references-update-wizard/
.agents/@montflow/workspace.json
.agents/references


# --- scratch / test ---
tmp/
.tmp/

# --- montflow loop runtime state ---
.agents/@montflow/loops

# --- montflow claim registry (runtime only; never a spec file) ---
.agents/@montflow/.runtime/

# --- machine-local plugin configuration ---
# A worktree's own model-fallback chain names providers/models only this
# machine has; the host config that registers the local checkout is local too.
.agents/@montflow/model-fallback/
/opencode.jsonc
/opencode.json

# --- montflow session transcripts (local only) ---
.agents/@montflow/sessions

# --- scratchpad (local only, keep dir shell) ---
scratchpad/*
!scratchpad/.gitkeep

# --- direnv / nix-direnv (machine-local) ---
.direnv/
.envrc

# --- git worktrees (project-local, isolated feature branches) ---
.worktrees/

# --- git worktrees: feat/ branches (project-local) ---
feat/

