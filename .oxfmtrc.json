{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist",
    "node_modules",
    "build",
    "**/build/**",
    "**/*.generated.ts",
    "**/scripts/**",
    "tooling/oxlint/anti-slop",
    "packages/principles/principles",
    "packages/playbooks/playbooks",
    "packages/mode/skills",
    "packages/mode/profiles",
    "pi"
  ]
}
