{
  "name": "@montflow/eslint",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/base.js",
    "./base": "./src/base.js",
    "./base.js": "./src/base.js",
    "./typescript": "./src/typescript.js",
    "./typescript.js": "./src/typescript.js",
    "./prettier": "./src/prettier.js",
    "./prettier.js": "./src/prettier.js"
  },
  "main": "./src/base.js",
  "files": [
    "*.js"
  ],
  "scripts": {
    "format:check": "prettier --check \"*.js\"",
    "format:fix": "prettier --write \"*.js\""
  },
  "dependencies": {
    "@montflow/prettier": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "eslint-config-prettier": "^9.1.2"
  }
}