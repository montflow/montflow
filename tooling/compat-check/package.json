{
  "name": "@montflow/tooling-compat-check",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-drift and private-distribution checks for the montflow workspace",
  "license": "MIT",
  "author": "Daniel Montilla",
  "bin": {
    "mf-compat-check": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "bun run src/main.ts",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck",
    "ts:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
