{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "build",
    "outDir": "build",
    "tsBuildInfoFile": ".tsbuildinfo/build.tsbuildinfo",
    "sourceMap": true,
    "declarationMap": true,
    "removeComments": false,
    "downlevelIteration": true,
    "isolatedModules": true,
    "esModuleInterop": false,
    "emitDeclarationOnly": true,
    "inlineSources": true
  }
}
