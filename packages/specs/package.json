{
  "name": "@montflow/specs",
  "version": "0.0.1",
  "private": true,
  "description": "Effect-first spec primitives and the mf-specs CLI, ported onto the OpenCode v2 adapter",
  "keywords": [
    "effect",
    "opencode",
    "specs"
  ],
  "bugs": {
    "url": "https://github.com/montflow/montflow/issues"
  },
  "license": "MIT",
  "author": "Daniel Montilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montflow/montflow.git",
    "directory": "packages/specs"
  },
  "bin": {
    "mf-specs": "./src/apps/cli/main.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts",
    "./services": "./src/services/index.ts",
    "./modules": "./src/modules/index.ts"
  },
  "scripts": {
    "cli": "bun run src/apps/cli/main.ts",
    "build:cli": "bun build src/apps/cli/main.ts --compile --outfile dist/mf-specs",
    "fixtures:check": "bun run src/apps/cli/main.ts check --dir fixtures",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@montflow/opencode": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.1",
    "@types/node": "^26.1.2",
    "effect": "4.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "effect": "4.0.1"
  }
}
