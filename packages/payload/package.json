{
  "name": "@montflow/payload",
  "version": "0.0.0",
  "private": true,
  "description": "Manifest-driven embedded payloads and the one doctor install/compare engine shared by every mf-* CLI",
  "keywords": [
    "doctor",
    "effect",
    "payload"
  ],
  "bugs": {
    "url": "https://github.com/montflow/montflow/issues"
  },
  "license": "MIT",
  "author": "Daniel Montilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montflow/montflow.git",
    "directory": "packages/payload"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.1",
    "@types/node": "^26.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "effect": "4.0.1"
  }
}
