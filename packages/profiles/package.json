{
  "name": "@montflow/profiles",
  "version": "0.0.1",
  "private": true,
  "description": "Effect-first agent profile primitives (profiles, PROFILE.md store) and the mf-profiles CLI",
  "keywords": [
    "effect",
    "profiles"
  ],
  "bugs": {
    "url": "https://github.com/montflow/montflow/issues"
  },
  "license": "MIT",
  "author": "Daniel Montilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montflow/montflow.git",
    "directory": "packages/profiles"
  },
  "bin": {
    "mf-profiles": "./src/apps/cli/main.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "cli": "bun run src/apps/cli/main.ts",
    "build:cli": "bun build src/apps/cli/main.ts --compile --outfile dist/mf-profiles",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@montflow/opencode": "workspace:*",
    "@montflow/pi-effect": "workspace:*",
    "@montflow/skills": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^26.1.2",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
