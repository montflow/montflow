{
  "name": "@montflow/telemetry",
  "version": "0.0.1",
  "private": true,
  "description": "Headless OpenCode session telemetry: in-process NDJSON capture with no listener, port, or network call",
  "keywords": [
    "montflow",
    "observability",
    "opencode",
    "plugin",
    "telemetry"
  ],
  "bugs": {
    "url": "https://github.com/montflow/montflow/issues"
  },
  "license": "MIT",
  "author": "Daniel Montilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montflow/montflow.git",
    "directory": "packages/telemetry"
  },
  "bin": {
    "mf-telemetry": "./src/apps/cli/main.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "cli": "bun run src/apps/cli/main.ts",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck && bun test src/modules/viewer/tests",
    "viewer:acceptance": "bun run scripts/viewer-acceptance.ts",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18",
    "effect": "4.0.0-rc.112",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@opencode/client": "2.0.18",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
