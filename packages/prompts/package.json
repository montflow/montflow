{
  "name": "@montflow/prompts",
  "version": "0.0.1",
  "private": true,
  "description": "Effect-first prompt template primitives (prompt descriptors, variable rendering) and the mf-prompts CLI",
  "keywords": [
    "effect",
    "prompts"
  ],
  "bugs": {
    "url": "https://github.com/montflow/montflow/issues"
  },
  "license": "MIT",
  "author": "Daniel Montilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montflow/montflow.git",
    "directory": "packages/prompts"
  },
  "bin": {
    "mf-prompts": "./src/apps/cli/main.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "build:cli": "bun run scripts/generate-embedded-skills.ts && bun build src/apps/cli/main.ts --compile --outfile dist/mf-prompts",
    "cli": "bun run src/apps/cli/main.ts",
    "generate:payload": "bun run scripts/generate-embedded-skills.ts",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@montflow/opencode": "workspace:*",
    "@montflow/version": "workspace:*",
    "handlebars": "4.7.9"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^26.1.2",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
