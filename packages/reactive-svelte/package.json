{
	"name": "@montflow/reactive-svelte",
	"version": "1.0.0-alpha.1",
	"scripts": {
		"dev": "vite dev",
		"build-app": "vite build && npm run prepack",
		"test": "vitest",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"build": "svelte-kit sync && svelte-package && publint",
		"publish": "bun run build && bun publish --access public --no-git-checks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@montflow/core": "workspace:^",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"jsdom": "^26.1.0",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.2.6"
	},
	"keywords": [
		"svelte"
	]
}