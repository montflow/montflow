{
  "name": "@montflow/linting",
  "version": "0.0.1",
  "private": true,
  "description": "Montflow oxlint plugin for custom lint rules",
  "keywords": [
    "lint",
    "montflow",
    "oxlint"
  ],
  "bugs": {
    "url": "https://github.com/montflow/montflow/issues"
  },
  "license": "MIT",
  "author": "Daniel Montilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montflow/montflow.git",
    "directory": "packages/linting"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --typecheck --passWithNoTests",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
