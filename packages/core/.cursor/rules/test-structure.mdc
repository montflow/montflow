Vitest.describe("[types] ModuleName.utilityName", () => {
  Vitest.it("should be defined", () => {
    type Test = typeof ModuleName.utilityName;
    Vitest.expectTypeOf<Test>().not.toEqualTypeOf<undefined>();
  });
});
```

