{
  "name": "@montflow/root",
  "author": "Daniel Montilla",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "core:test": "pnpm run --filter @montflow/core test",
    "core:build": "pnpm run --filter @montflow/core build",
    "core:dev": "pnpm run --filter @montflow/core dev",
    "core:publish": "pnpm run --filter @montflow/core publish",
    "core:check": "pnpm run --filter @montflow/core check",
    "stlx:test": "pnpm run --filter @montflow/stlx test",
    "stlx:build": "pnpm run --filter @montflow/stlx build",
    "stlx:dev": "pnpm run --filter @montflow/stlx dev",
    "stlx:publish": "pnpm run stlx:build && pnpm run --filter @montflow/stlx publish --access public --no-git-checks",
    "clean": "pnpm -r exec rimraf build .rollup.cache .tsbuildinfo .svelte-kit .vercel .turbo",
    "deep-clean": "pnpm clean && pnpm -r exec rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-svelte": "^3.2.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}