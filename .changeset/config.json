{
  "$schema": "https://unpkg.com/@changesets/config@1.6.4/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "montflow/montflow" }],
  "commit": false,
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "@montflow/linting",
    "@montflow/model-fallback",
    "@montflow/opencode",
    "@montflow/profiles",
    "@montflow/prompts",
    "@montflow/reviews",
    "@montflow/skills",
    "@montflow/specs",
    "@montflow/stlx",
    "@montflow/tooling-pack",
    "@montflow/tooling-oxfmt",
    "@montflow/tooling-oxlint",
    "@montflow/tooling-typescript",
    "@montflow/workspace",
    "@montflow/workflows"
  ],
  "privatePackages": {
    "version": false,
    "tag": false
  }
}
