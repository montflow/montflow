{
  "version": 1,
  "type": "loop",
  "name": "adversarial-review",
  "config": {
    "steps": [
      {
        "id": "s1",
        "kind": "reviewer-group",
        "label": "Reviewers",
        "reviewers": [
          {
            "reviewer": {
              "type": "profile",
              "name": "pattern-consistency-reviewer",
              "model": "opencode-go/ox-alpha-free",
              "fallbackModel": "opencode-go/deepseek-v4-flash"
            }
          },
          {
            "reviewer": {
              "type": "profile",
              "name": "documentation-reviewer",
              "model": "opencode-go/ox-alpha-free",
              "fallbackModel": "opencode/deepseek-v4-flash"
            }
          },
          {
            "reviewer": {
              "type": "profile",
              "name": "language-quality-reviewer",
              "model": "opencode-go/hy3",
              "fallbackModel": "opencode-go/ox-alpha-free"
            }
          }
        ],
        "model": "opencode-go/ox-alpha-free",
        "fallbackModel": "opencode/deepseek-v4-flash",
        "concurrency": 3
      },
      {
        "id": "s2",
        "kind": "fixers",
        "label": "Fix",
        "model": "opencode-go/ox-alpha-free",
        "fallbackModel": "opencode-go/deepseek-v4-flash",
        "concurrency": 5
      }
    ],
    "maxLoops": 3,
    "maxCycles": 5,
    "deadlock": {
      "flipThreshold": 2,
      "action": "escalate"
    },
    "supervisor": {
      "model": "opencode-go/ox-alpha-free",
      "fallbackModel": "opencode-go/deepseek-v4-flash"
    },
    "bookkeeper": {
      "model": "opencode-go/ox-alpha-free",
      "fallbackModel": "opencode-go/deepseek-v4-flash"
    }
  }
}
